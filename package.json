{
  "name": "mamaco-notes",
  "private": true,
  "version": "1.0.69",
  "author": "Mamaco Team <yabaihonyaku@gmail.com>",
  "desktopName": "Mamaco Notes",
  "description": "Mamaco Notes - app de anotações digitais com suporte a caneta para Windows, Linux e Android",
  "homepage": "https://github.com/SorrisoKDente/MamacoNotes",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tsc --noEmit && vite build && electron-builder",
    "build:win": "tsc --noEmit && vite build && electron-builder --win nsis",
    "build:win:portable": "tsc --noEmit && vite build && electron-builder --win portable",
    "build:linux": "tsc --noEmit && vite build && electron-builder --linux AppImage deb",
    "build:linux:appimage": "tsc --noEmit && vite build && electron-builder --linux AppImage",
    "build:linux:deb": "tsc --noEmit && vite build && electron-builder --linux deb",
    "preview": "vite preview",
    "build:android": "tsc --noEmit && vite build && cap sync android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.mamaconotes.app",
    "productName": "Mamaco Notes",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build-resources/**/*"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mamaco Notes"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build-resources/icon.png",
      "syncDesktopName": true,
      "category": "Office",
      "maintainer": "Mamaco Team <yabaihonyaku@gmail.com>"
    }
  },
  "overrides": {
    "glob": "^13.0.0",
    "rimraf": "^5.0.10"
  }
}
